# Redis / broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
STREAM_NAME=pulsegrid:events
DEAD_LETTER_STREAM=pulsegrid:events:dlq
CONSUMER_GROUP=pulsegrid-processors
CONSUMER_NAME=processor-1
STREAM_MAX_LEN=200000

# Storage
DB_PATH=data/pulsegrid.db

# Producer
EVENT_SOURCES=12
BASE_EVENTS_PER_SEC=20
ANOMALY_PROBABILITY=0.03
MISSING_EVENT_PROBABILITY=0.02

# Processing / anomaly detection
ROLLING_WINDOW_SIZE=50
EWMA_ALPHA=0.3
ZSCORE_THRESHOLD=3.0
MIN_SAMPLES_FOR_DETECTION=15
HEARTBEAT_TIMEOUT_SEC=8
AGGREGATION_WINDOW_SEC=10

# Fault tolerance
MAX_RETRIES=3
PENDING_CLAIM_IDLE_MS=30000
BATCH_SIZE=50
BLOCK_MS=2000

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
